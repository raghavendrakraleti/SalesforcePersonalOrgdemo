    <validationRules>
        <fullName>FullName</fullName>
        <active>false</active>
        <errorConditionFormula>NOT( OR(CONTAINS( Name , &quot; &quot;) ,CONTAINS( Name , &quot;.&quot;)) )</errorConditionFormula>
        <errorMessage>please Enter Valid Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>isEditabel</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(isEditable__c)</errorConditionFormula>
        <errorMessage>This Record is Not editable because This is created on CreatedDate</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Namefield_validation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISNEW(),
NOT(ISBLANK(Name)),
NOT(REGEX(Name,&quot;([a-zA-Z])*+([.])*+([ ])*+([a-zA-Z])*+([ ])*+([a-zA-Z])*&quot;))


)</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Give your Full Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Phone_Required_For_Customer_Direct</fullName>
        <active>true</active>
        <description>Phone is required when Account Type is Customer - Direct.</description>
        <errorConditionFormula>AND(ISPICKVAL(Type, &quot;Customer - Direct&quot;), ISBLANK(Phone))</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
        <errorMessage>Phone is required for accounts with Type &quot;Customer - Direct&quot;. Please enter a phone number before saving.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Billing</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>true</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>true</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Billing</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>true</showsLocation>
        <showsStatus>true</showsStatus>
        <url>http://www.genwatt.com/genwatt/billing.htm?actname={!Account_Name}</url>
    </webLinks>
</CustomObject>